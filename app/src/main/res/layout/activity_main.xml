<?xml version="1.0" encoding="utf-8"?>
<com.flowseal.tgwsproxy.AdaptiveScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/mainScroll"
    android:background="@color/app_bg_start"
    android:fillViewport="true"
    android:clipToPadding="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textSize="24sp"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_idle_title"
            android:textSize="22sp"
            android:textColor="@color/text_primary"
            android:id="@+id/heroTitle"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_idle_body"
            android:textSize="16sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/heroBody"
            android:layout_marginTop="4dp" />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/stopButton"
            android:background="@drawable/bg_primary_button"
            android:minHeight="52dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/primary_action_start"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="20dp"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/connectButton"
            android:background="@drawable/bg_secondary_button"
            android:minHeight="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="@string/primary_action"
            android:textAllCaps="false"
            android:textColor="@color/brand_dark"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            android:stateListAnimator="@null"
            android:elevation="0dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_connection_section"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="24dp"
            android:fontFamily="sans-serif-medium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:layout_marginTop="8dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_endpoint_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/home_endpoint_placeholder"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/endpointValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/stroke" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_latency_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_latency_value"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/routeValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_panel"
            android:layout_marginTop="20dp"
            android:clipToOutline="true">
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/appearanceRow"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/appearance_title"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="8dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/stroke" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/profileRow"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/profile_title"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:drawableEnd="@drawable/ic_chevron_right"
                android:drawablePadding="8dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/stroke" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/detailsToggleButton"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/show_diagnostics"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/stroke" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/proxyRow"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/home_copy_link"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark"
                android:textSize="16sp"
                android:fontFamily="sans-serif"
                android:gravity="start|center_vertical"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/diagnosticsContainer"
            android:background="@drawable/bg_panel"
            android:layout_marginTop="16dp"
            android:padding="16dp"
            android:visibility="gone">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/metrics_title"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_sessions_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_sessions_value"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/sessionsValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_protection_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/metric_protection_value"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/trafficValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_status_empty"
                android:textSize="14sp"
                android:textColor="@color/text_primary"
                android:id="@+id/routeStatusValue"
                android:layout_marginTop="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_policy_empty"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/routePolicyValue"
                android:layout_marginTop="6dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/network_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/network_unknown"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/networkValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/link_mode_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/link_mode_fake_tls"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:id="@+id/linkModeValue"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:layout_marginStart="12dp" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@color/stroke" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/footer_body"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/footerBody"
                android:layout_marginTop="12dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/route_health_empty"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/routeHealthValue"
                android:layout_marginTop="8dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/log_empty"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/connectionLogValue"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@drawable/bg_route_badge" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/settingsButton"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/settings_action"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="8dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/logsButton"
                android:background="@drawable/bg_secondary_button"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/logs_action"
                android:textAllCaps="false"
                android:textColor="@color/brand_dark"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="4dp"
                android:stateListAnimator="@null"
                android:elevation="0dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/build_info_placeholder"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/buildInfoValue"
                android:gravity="center"
                android:layout_marginTop="12dp" />
        </LinearLayout>
        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/background_warning"
            android:textSize="14sp"
            android:textColor="@color/brand_dark"
            android:id="@+id/backgroundWarning"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground"
            android:textAllCaps="false"
            android:gravity="start|center_vertical"
            android:fontFamily="sans-serif"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:visibility="gone"
            android:paddingStart="0dp"
            android:paddingEnd="0dp" />
    </LinearLayout>
</com.flowseal.tgwsproxy.AdaptiveScrollView>